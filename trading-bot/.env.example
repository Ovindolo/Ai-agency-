# Copy to .env (never commit .env). Every key here is optional; the bot runs in paper mode without them.

# Telegram: bot from @BotFather, your numeric id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

# Futures journal + guard: Binance API key with ONLY "Enable Reading" ticked.
# A key that can withdraw is refused; a key that can trade is refused unless --allow-trading-key.
FUTURES_API_KEY=
FUTURES_API_SECRET=

# Spot fees (make fees): a read-only key is enough
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Jev (optional): empty -> deterministic rules only
TYPESAFE_API_KEY=
JEV_ENABLED=true
# Or a local Jev-compatible server instead of the paid API (no key needed), e.g. Kev (github.com/jaredpalmer/kev):
#   uv run --extra serve python -m kev.serve --run jaredpalmer/kev-4b --port 8009
JEV_BASE_URL=
JEV_MODEL_ID=jev-latest

# Insider screen + alerts (US equities, research only)
# SEC requires a declared User-Agent: your name and an email you own
SEC_USER_AGENT=
# Optional: Quiver subscription for Congress, lobbying, government contracts, 13F
QUIVER_API_KEY=
